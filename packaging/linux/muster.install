# The two capabilities Muster asks a package manager for.
#
# `CAP_NET_BIND_SERVICE` is the right to bind a port below 1024, and the DHCP
# check needs it: a client has to be listening on port 68 to hear an offer at
# all, so without this that feature reports "Permission denied" and nothing
# else, on every machine, for ever.
#
# `CAP_NET_RAW` is the ICMP echo's fallback. Ping sockets are gated on
# `net.ipv4.ping_group_range` and several distributions leave it shut, and
# without a raw socket Muster reports "no echo was sent" for every device it
# finds. It is what `ping` itself carries, and it is still short of the
# privileged engine, which will want `CAP_NET_ADMIN` beside it. See the long
# note in `build-packages.sh`, which grants the same two to the .deb and .rpm.
#
# `|| true`: setcap comes from `libcap`, and a package must not fail to install
# over an optional feature. Without it Muster simply keeps saying what it cannot
# do, which is what it did before.
_grant() {
    if command -v setcap >/dev/null 2>&1; then
        setcap cap_net_bind_service,cap_net_raw=+ep /usr/bin/muster || true
    fi
}

# The house archive, so that `pacman -Syu` keeps Muster current. Without it the
# package came from a release page, is in no repository pacman knows, and every
# upgrade is a file somebody has to go and fetch by hand.
#
# Copied from `../Packages/ENROLMENT.md`, which is the same in every application
# and is the place to change it: created and never overwritten, never removed
# on the way out because the other applications use it too, a `.disabled`
# marker honoured, and nothing here may fail the install. `packaging/check.sh`
# fails if these paths drift from the ones the updater looks for.
_spillebulle_archive() {
    local conf=/etc/pacman.d/spillebulle
    local fpr=7A9EA69E033F3C3EF4F53EB4A72BC0FD5E061ADA
    [ -e "$conf.disabled" ] && return 0
    # Every time, not only when the key is missing: both are idempotent, and
    # a key present but never signed (an earlier attempt that failed) would
    # otherwise stay "unknown trust" for ever and stop `pacman -Syu`.
    if command -v pacman-key >/dev/null 2>&1; then
        pacman-key --add /usr/share/muster/spillebulle-archive.asc >/dev/null 2>&1 || true
        pacman-key --lsign-key "$fpr" >/dev/null 2>&1 || true
    fi
    if [ ! -e "$conf" ]; then
        printf '%s\n' \
            'SigLevel = Required DatabaseRequired' \
            'Server = https://spillebulle.github.io/packages/arch/$arch' > "$conf" || true
    fi
    if ! grep -q '^\[spillebulle\]' /etc/pacman.conf 2>/dev/null; then
        printf '\n[spillebulle]\nInclude = %s\n' "$conf" >> /etc/pacman.conf || true
    fi
}

post_install() {
    _grant
    _spillebulle_archive
}

post_upgrade() {
    _grant
    _spillebulle_archive
}
